#include <windows.h>
#include <commctrl.h>

#include "setup/Resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_SETUP DIALOGEX 0, 0, 316, 198
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Black & White Decompilation Setup"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_HEADING, 12, 10, 292, 14
    LTEXT           "Adds the decompilation's launcher, fixes and Direct3D 9 renderer to an installed copy of Black && White. The game is not included, and none of its files are changed.", IDC_INTRO, 12, 28, 292, 26
    LTEXT           "&Game folder (the one with runblack.exe):", IDC_FOLDER_LABEL, 12, 60, 292, 9
    EDITTEXT        IDC_FOLDER, 12, 71, 236, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 254, 70, 50, 16
    CONTROL         "", IDC_STATUS_ICON, "Static", SS_ICON | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE, 12, 94, 16, 16
    LTEXT           "", IDC_STATUS, 38, 95, 266, 44, SS_NOPREFIX
    AUTOCHECKBOX    "Add a shortcut to the &Start menu", IDC_STARTMENU, 12, 146, 292, 10
    AUTOCHECKBOX    "Add a shortcut to the &desktop", IDC_DESKTOP, 12, 159, 292, 10
    DEFPUSHBUTTON   "&Install", IDOK, 196, 176, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 254, 176, 50, 15
END
